entrypoint = "server/index.js"
modules = ["web", "python-base-3.13", "nodejs-24", "postgresql-16"]

[deployment]
deploymentTarget = "static"
publicDir = "/"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Serve Ghettochip"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm start"
waitForPort = 5000

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Serve Ghettochip"

[[workflows.workflow]]
name = "Serve Ghettochip"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 80
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "atk", "cups", "dbus", "expat", "fontconfig", "freetype", "gdk-pixbuf", "gtk3", "libdrm", "libxkbcommon", "mesa", "pango", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libXcursor", "xorg.libXi", "libgbm", "alsa-lib"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
